max.overlaps       = 20,
size               = 3,
force              = 8,
force_pull         = 0.2
) +
geom_point(
aes(fill = color),
shape = 21,
size  = 2
) +
ribosomal_fill_scale +
geom_hline(
yintercept = -log10(fdr_cutoff),
linetype   = "dashed",
color      = "grey40"
) +
geom_vline(
xintercept = c(-1, 1),
linetype   = "dashed",
color      = "grey40"
) +
labs(
x     = expression(log[2]("fold change")),
y     = expression(-log[10](padj)),
title = title_text
) +
theme_bw()
}
