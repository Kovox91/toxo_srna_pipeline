volcano_faceted <- volcano %>%
filter(contrast %in% c("pr0_pr1", "pr0_pr2", "pr0_pr3")) %>%
mutate(
contrast_label = factor(
contrast,
levels = c("pr0_pr1",      "pr0_pr2",      "pr0_pr3"),
labels = c("Day 0 vs Day 1", "Day 0 vs Day 2", "Day 0 vs Day 3")
)
)
volcano_facet <- ggplot(
data = volcano_faceted,
aes(x = logFC, y = y_var)
) +
geom_text_repel(
aes(label = label),
segment.color      = "black",
min.segment.length = 0.1,
point.size = 3,
max.overlaps       = 40,
size               = 3,
force              = 8,
force_pull         = 0.2
) +
geom_point(
aes(fill = color),
shape = 21,
size  = 3
) +
ribosomal_fill_scale +
geom_hline(
yintercept = -log10(fdr_cutoff),
linetype   = "dashed",
color      = "grey40"
) +
geom_vline(
xintercept = c(-1, 1),
linetype   = "dashed",
color      = "grey40"
) +
labs(
x = expression(log[2] * "(fold change)"),
y = expression("-"*log[10] * "(padj)")
) +
facet_grid(
rows  = vars(contrast_label),
cols  = vars(),            # important: avoid column facets
space  = "free_x",         # ensures spacing matches data
switch = "x"               # puts x-axis at top of each panel
) +
theme_bw() +
theme(
strip.placement = "outside",
strip.text.y.left = element_text(angle = 0),  # readable facet labels
legend.position = "right")
print(volcano_facet)
ggsave(plot = volcano_facet,
path = plot_dir,
filename = "volcano_facetted.svg",
device = "svg",
width = 340/2,
height = 401/2,
units = "mm",
)
