linetype = "dashed",
color = "grey40") +
# Adjust titles
labs(x = expression(log[2]("fold change")),
y = expression(-log[10](padj)),
title = "Day 0 vs Day 3") +
# Set theme
theme_bw()
suppressWarnings(ggplotly(volc1, tooltip = c("ID")))
