library(dplyr)
library(kSamples)
library(tidyr)
library(tibble)
library(parallel)
# 1D Wasserstein distance for discrete integer polyA lengths
wasserstein_discrete <- function(x, y) {
all_vals <- sort(unique(c(x, y)))
c1 <- tabulate(factor(x, levels = all_vals))
c2 <- tabulate(factor(y, levels = all_vals))
p1 <- c1 / sum(c1)
p2 <- c2 / sum(c2)
cdf1 <- cumsum(p1)
cdf2 <- cumsum(p2)
# step size is 1 nt, so W1 = sum |CDF1 - CDF2|
sum(abs(cdf1 - cdf2))
}
test_polyA <- function(g, n_perm = 1000) {
df <- polyA_raw %>%
filter(Geneid == g) %>%
mutate(condition = substr(sample, 1, 3)) %>%
tidyr::uncount(n)  # expanded molecules
conds <- unique(df$condition)
pairs <- combn(conds, 2, simplify = FALSE)
results <- mclapply(pairs, function(p) {
# subset for this pair
df_pair <- df %>% filter(condition %in% p)
x <- df_pair$polyA[df_pair$condition == p[1]]
y <- df_pair$polyA[df_pair$condition == p[2]]
# Anderson–Darling test
ad <- kSamples::ad.test(x, y)
p_ad <- ad$ad[1, 3]   # asymptotic p-value (row 1, col 3)
# Wasserstein effect size (in nt)
w_obs <- wasserstein_discrete(x, y)
# Permutation test on Wasserstein
labels <- df_pair$condition
w_perm <- numeric(n_perm)
for (i in seq_len(n_perm)) {
shuffled <- sample(labels)
x_perm <- df_pair$polyA[shuffled == p[1]]
y_perm <- df_pair$polyA[shuffled == p[2]]
w_perm[i] <- wasserstein_discrete(x_perm, y_perm)
}
# one-sided: observed >= permuted
p_perm <- (1 + sum(w_perm >= w_obs)) / (n_perm + 1)
tibble(
Geneid      = g,
cond1       = p[1],
cond2       = p[2],
p_ad        = p_ad,
wasserstein = w_obs,
p_perm      = p_perm
)
}, mc.cores = 3)
bind_rows(results)
}
gc()
stats_polyA <- bind_rows(mclapply(genes_of_interest, test_polyA, mc.cores = 12)) %>%
mutate(
p_ad_fdr   = p.adjust(p_ad,   method = "fdr"),
p_perm_fdr = p.adjust(p_perm, method = "fdr")
)
plot_dir
